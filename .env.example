JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
AI_PROVIDER=local-fallback
DATABASE_URL=postgresql+psycopg://xmessenger:xmessenger_dev@postgres:5432/xmessenger

# Authentication/session hardening
ACCESS_MINUTES=30
REFRESH_DAYS=30
OTP_MINUTES=10
RECOVERY_MINUTES=30
AUTH_RATE_LIMIT=8
DEV_EXPOSE_OTP=false

# Google Sign-In / OpenID Connect
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-web-client-id.apps.googleusercontent.com

# Media pipeline
MEDIA_MAX_BYTES=104857600
CONNECTION_TIMEOUT_SECONDS=75
REALTIME_MAX_REPLAY=500

# Realtime / multi-instance
REDIS_URL=redis://localhost:6379/0
REALTIME_CHANNEL=hamraz:realtime:v1
REALTIME_NODE_ID=
HEARTBEAT_SECONDS=25

# Stories
STORY_THUMBNAIL_MAX=720

# Part 8: WebRTC / TURN
# Keep TURN credentials server-side. The authenticated /api/calls/ice-config endpoint exposes them to active clients.
TURN_URL=
TURN_USERNAME=
TURN_PASSWORD=

# Part 9 distributed connectivity
HAMRAZ_REGION=local-1
PUBLIC_BASE_URL=http://localhost:8000
CDN_BASE_URL=
CDN_SIGNING_SECRET=replace-with-a-dedicated-cdn-signing-secret
SYNC_MAX_BATCH=500
P2P_OFFER_MINUTES=10
# STUN/TURN values are configured once above.
STUN_URL=stun:stun.l.google.com:19302
# Search Core
HAMRAZ_SEARCH_MODE=embedded
OPENSEARCH_URL=
OPENSEARCH_INDEX=hamraz
SEARCH_MAX_LIMIT=100
SEARCH_REINDEX_BATCH=500

# Self-hosted deployment
HAMRAZ_DOMAIN=localhost
POSTGRES_PASSWORD=change-me
MINIO_ROOT_USER=hamraz
MINIO_ROOT_PASSWORD=change-me-minio
# AI Core (Part 12)
AI_PROVIDER_ORDER=openai,gemini,cerebras,local
AI_JOB_POLL_SECONDS=0.6
AI_MAX_RETRIES=6
AI_JOB_BATCH=8
AI_CONTEXT_MESSAGES=24
AI_MAX_PROMPT_CHARS=16000
AI_EMBED_DIM=96
AI_PROVIDER_TIMEOUT=20
AI_MODERATION_ENABLED=true
AI_MODERATION_THRESHOLD=0.82
AI_TEMPERATURE=0.2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1/chat/completions
CEREBRAS_MODEL=llama-3.3-70b

ADMIN_AUDIT_SECRET=replace-with-a-dedicated-admin-audit-secret

COMMERCE_WEBHOOK_SECRET=replace-with-a-long-webhook-secret

INFRA_HEARTBEAT_SECRET=replace-with-a-long-heartbeat-secret

MINIO_IMAGE_TAG=REPLACE_WITH_PINNED_VERSION
